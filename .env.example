# ── VYUH MEDIA — environment ────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in what you need.
# The site builds and runs with none of these set; the contact form then
# reports honestly that it is not connected, rather than faking a success.

# Preferred: any endpoint that accepts a JSON POST (Formspree, Zapier, Make,
# a CRM, or your own handler). Receives:
#   { name, email, organisation, topic, message, submittedAt, source }
CONTACT_WEBHOOK_URL=""

# Alternative: send email through the Resend HTTP API instead of a webhook.
# If both are set, the webhook wins.
RESEND_API_KEY=""
CONTACT_TO_EMAIL="admin@vaibhavpratap.in"
# Must be a domain verified in Resend, e.g. "VYUH MEDIA <no-reply@vaibhavpratap.in>"
CONTACT_FROM_EMAIL=""
